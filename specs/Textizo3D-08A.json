{
  "name": "Textizo3D-08A",
  "notes": "Camo: woodland camouflage printed on each letter, dark olive sides, matte, a warm key light; slams in.",
  "text": "ARMY",
  "font": "Archivo Black",
  "style": "Regular",
  "in": {
    "opacity": {
      "by": "letters",
      "order": "left_to_right",
      "start": 0,
      "end": 4,
      "stagger": 30,
      "from": 0,
      "to": 1,
      "ease": "out_quad"
    },
    "size": {
      "by": "letters",
      "order": "left_to_right",
      "start": 0,
      "end": 8,
      "stagger": 30,
      "from": 1.6,
      "to": 1,
      "ease": "out_expo"
    }
  },
  "inputs": {
    "RotationX": -4,
    "RotationY": -10,
    "ExtrusionDepth": 0.3,
    "BevelDepth": 0.02,
    "BevelWidth": 0.02,
    "SmoothingAngle": 40,
    "SideColor": [0.16, 0.18, 0.09],
    "T3Roughness": 0.85,
    "T3Coat": 0,
    "T3Smudges": 0,
    "T3Glow": 0.15,
    "T3GlowThreshold": 0.8,
    "T3CamFov": 36,
    "T3CamOrbit": -10,
    "T3CamTilt": -8,
    "MotionBlur": true,
    "BlurQuality": 6,
    "T3KeyIntensity": 1.1,
    "KeyColor": [1.0, 0.95, 0.85],
    "T3FillIntensity": 0.2,
    "T3AmbientIntensity": 0.3,
    "T3UnderIntensity": 0.25,
    "UnderColor": [0.75, 0.7, 0.45],
    "T3EnvIntensity": 0.4,
    "FaceTexture": "textures/camo.jpg",
    "TexScale": 1.6
  }
}
