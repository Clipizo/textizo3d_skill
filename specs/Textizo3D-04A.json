    "SideColor": [0.9, 0.93, 0.97],
    "T3Roughness": 0.04,
    "T3Metal": 1,
    "T3Coat": 0,
    "T3Smudges": 0,
    "T3Glow": 0.25,
    "T3GlowSize": 25,
    "T3GlowThreshold": 0.9,
    "T3CamFov": 34,
    "T3CamOrbit": -8,
    "T3CamTilt": -10,
    "T3KeyIntensity": 0.3,
    "T3FillIntensity": 0,
    "T3AmbientIntensity": 0,
    "EnvImage": "textures/env-sky.hdr"
  }
