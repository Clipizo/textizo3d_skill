{
  "name": "Textizo3D-04A",
  "notes": "Sky chrome: white chrome faces, the sky's blue in the chamfer and the sides, deep extrusion, low camera.",
  "text": "LEGEND",
  "font": "Archivo Black",
  "style": "Regular",
  "in": {
    "opacity": {
      "by": "letters",
      "order": "left_to_right",
      "start": 0,
      "end": 10,
      "stagger": 35,
      "from": 0,
      "to": 1,
      "ease": "out_quad"
    },
    "blur": {
      "by": "letters",
      "order": "left_to_right",
      "start": 0,
      "end": 14,
      "stagger": 35,
      "from": 0.1,
      "to": 0,
      "ease": "out_cubic"
    },
    "size": {
      "by": "letters",
      "order": "left_to_right",
      "start": 0,
      "end": 14,
      "stagger": 35,
      "from": 1.25,
      "to": 1,
      "ease": "out_back"
    }
  },
  "inputs": {
    "RotationX": -4,
    "RotationY": -12,
    "ExtrusionDepth": 0.24,
    "BevelDepth": 0.03,
    "BevelWidth": 0.03,
